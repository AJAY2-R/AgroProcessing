{
  "name": "agroprocessing",
  "version": "1.0.0",
  "description": "AgroProcessing with Tailwind CSS",
  "scripts": {
    "build:css": "npx tailwindcss -i ./wwwroot/css/site.css -o ./wwwroot/css/output.css --minify",
