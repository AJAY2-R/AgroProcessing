@* 
    Empty State Component
    Usage: @await Html.PartialAsync("_EmptyState", new EmptyStateModel { 
        Icon = "...", 
        Title = "...", 
        Description = "...", 
        ActionText = "...", 
        ActionUrl = "..." 
    })
*@

@model dynamic

<div class="text-center py-12">
    @if (!string.IsNullOrEmpty(Model?.Icon))
    {
        <div class="mx-auto h-12 w-12 text-gray-400">
            @Html.Raw(Model.Icon)
        </div>
    }
    else
    {
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
        </svg>
    }
    
    <h3 class="mt-2 text-sm font-medium text-gray-900">@(Model?.Title ?? "No items found")</h3>
    <p class="mt-1 text-sm text-gray-500">@(Model?.Description ?? "Get started by creating a new item.")</p>
    
    @if (!string.IsNullOrEmpty(Model?.ActionUrl))
    {
        <div class="mt-6">
            <a href="@Model.ActionUrl" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @(Model?.ActionText ?? "Add New")
            </a>
        </div>
    }
</div>
