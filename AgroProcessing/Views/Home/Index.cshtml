@{
    ViewData["Title"] = "Home";
    var totalFarmers = ViewBag.TotalFarmers ?? 0;
    var totalBuyers = ViewBag.TotalBuyers ?? 0;
    var totalProducts = ViewBag.TotalProducts ?? 0;
    var totalWorkers = ViewBag.TotalWorkers ?? 0;
    var pendingPurchases = ViewBag.PendingPurchases ?? 0;
    var openSales = ViewBag.OpenSales ?? 0;
    var pendingAmount = ViewBag.PendingAmount ?? 0m;
    var salesAmount = ViewBag.SalesAmount ?? 0m;
}

<!-- Hero Section with Live Stats -->
<div class="bg-gradient-to-r from-primary-500 to-primary-600 rounded-lg shadow-lg p-8 md:p-12 mb-8 text-gray-800">
    <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Welcome to AgroProcessing</h1>
        <p class="text-xl md:text-2xl text-primary-100 mb-6">
            Complete agricultural product processing management system
        </p>
        <p class="text-lg text-primary-50 mb-8">
            Track purchases from farmers, manage processing operations, control inventory, and handle sales to buyers - all in one integrated platform.
        </p>
        <div class="flex flex-wrap gap-4">
            <a asp-controller="Home" asp-action="Dashboard" 
               class="bg-white text-primary-600 hover:bg-primary-50 font-semibold py-3 px-6 rounded-lg transition-colors inline-flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                View Dashboard
            </a>
            <a asp-controller="Workflow" asp-action="Index"
               class="bg-primary-700 hover:bg-primary-800 text-white font-semibold py-3 px-6 rounded-lg transition-colors inline-flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                Workflow Management
            </a>
        </div>
    </div>
</div>

<!-- Live Statistics Cards -->
<div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">System Overview</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Master Data Stats -->
        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Total Farmers</p>
                    <p class="text-3xl font-bold text-gray-900">@totalFarmers</p>
                </div>
                <div class="bg-blue-100 rounded-full p-3">
                    <span class="text-3xl">👨‍🌾</span>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Farmers" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
                Manage Farmers →
            </a>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Total Buyers</p>
                    <p class="text-3xl font-bold text-gray-900">@totalBuyers</p>
                </div>
                <div class="bg-green-100 rounded-full p-3">
                    <span class="text-3xl">👥</span>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Buyers" class="text-green-600 hover:text-green-700 text-sm font-medium">
                Manage Buyers →
            </a>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Active Products</p>
                    <p class="text-3xl font-bold text-gray-900">@totalProducts</p>
                </div>
                <div class="bg-yellow-100 rounded-full p-3">
                    <span class="text-3xl">🌾</span>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Products" class="text-yellow-600 hover:text-yellow-700 text-sm font-medium">
                Manage Products →
            </a>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-purple-500">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Active Workers</p>
                    <p class="text-3xl font-bold text-gray-900">@totalWorkers</p>
                </div>
                <div class="bg-purple-100 rounded-full p-3">
                    <span class="text-3xl">👷</span>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Workers" class="text-purple-600 hover:text-purple-700 text-sm font-medium">
                Manage Workers →
            </a>
        </div>
    </div>
</div>

<!-- Operations Status -->
<div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Operations Status</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Pending Purchases -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                    <div class="bg-orange-100 rounded-full p-3 mr-4">
                        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Pending Purchases</h3>
                        <p class="text-sm text-gray-600">Awaiting processing</p>
                    </div>
                </div>
            </div>
            <div class="flex items-end justify-between">
                <div>
                    <p class="text-4xl font-bold text-gray-900">@pendingPurchases</p>
                    <p class="text-sm text-gray-600 mt-1">Total: ₹@pendingAmount.ToString("N2")</p>
                </div>
                <a asp-controller="Workflow" asp-action="Purchases" class="text-orange-600 hover:text-orange-700 font-medium">
                    View All →
                </a>
            </div>
        </div>

        <!-- Open Sales -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                    <div class="bg-green-100 rounded-full p-3 mr-4">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Open Sales</h3>
                        <p class="text-sm text-gray-600">Pending payments</p>
                    </div>
                </div>
            </div>
            <div class="flex items-end justify-between">
                <div>
                    <p class="text-4xl font-bold text-gray-900">@openSales</p>
                    <p class="text-sm text-gray-600 mt-1">Total: ₹@salesAmount.ToString("N2")</p>
                </div>
                <a asp-controller="Workflow" asp-action="Sales" class="text-green-600 hover:text-green-700 font-medium">
                    View All →
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Access Cards -->
<div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Quick Access</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Products Card -->
        <a asp-controller="Products" asp-action="Index" class="block group">
            <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-all hover:scale-105 cursor-pointer border-2 border-transparent hover:border-primary-500">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">Products</h3>
                    <span class="text-4xl">🌾</span>
                </div>
                <p class="text-gray-600 mb-4">Manage agricultural products and yield expectations</p>
                <div class="text-primary-600 font-medium group-hover:text-primary-700">
                    Manage Products →
                </div>
            </div>
        </a>
        
        <!-- Farmers Card -->
        <a asp-controller="Farmers" asp-action="Index" class="block group">
            <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-all hover:scale-105 cursor-pointer border-2 border-transparent hover:border-primary-500">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">Farmers</h3>
                    <span class="text-4xl">👨‍🌾</span>
                </div>
                <p class="text-gray-600 mb-4">Manage farmer contacts and suppliers</p>
                <div class="text-primary-600 font-medium group-hover:text-primary-700">
                    Manage Farmers →
                </div>
            </div>
        </a>
        
        <!-- Buyers Card -->
        <a asp-controller="Buyers" asp-action="Index" class="block group">
            <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-all hover:scale-105 cursor-pointer border-2 border-transparent hover:border-primary-500">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">Buyers</h3>
                    <span class="text-4xl">👥</span>
                </div>
                <p class="text-gray-600 mb-4">Manage buyer contacts and credit limits</p>
                <div class="text-primary-600 font-medium group-hover:text-primary-700">
                    Manage Buyers →
                </div>
            </div>
        </a>
        
        <!-- Workers Card -->
        <a asp-controller="Workers" asp-action="Index" class="block group">
            <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-all hover:scale-105 cursor-pointer border-2 border-transparent hover:border-primary-500">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">Workers</h3>
                    <span class="text-4xl">👷</span>
                </div>
                <p class="text-gray-600 mb-4">Manage processing workers and rates</p>
                <div class="text-primary-600 font-medium group-hover:text-primary-700">
                    Manage Workers →
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Operations Section -->
<div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Core Operations</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Purchases Card -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Purchases</h3>
                <span class="text-3xl">🛒</span>
            </div>
            <p class="text-gray-600 mb-4">Record raw material purchases from farmers with payment tracking</p>
            <div class="space-y-2">
                <a asp-controller="Workflow" asp-action="CreatePurchase" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Create Purchase Batch
                </a>
                <a asp-controller="Workflow" asp-action="Purchases" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Pending Batches
                </a>
                <a asp-controller="Workflow" asp-action="Purchases" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Manage Payments
                </a>
            </div>
        </div>
        
        <!-- Processing Card -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Processing</h3>
                <span class="text-3xl">⚙️</span>
            </div>
            <p class="text-gray-600 mb-4">Track processing runs with multiple stages and worker assignments</p>
            <div class="space-y-2">
                <a asp-controller="Workflow" asp-action="CreateProcessingRun" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Create Processing Run
                </a>
                <a asp-controller="Workflow" asp-action="Processing" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Active Runs
                </a>
                <a asp-controller="Workflow" asp-action="Processing" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Worker Payments
                </a>
            </div>
        </div>
        
        <!-- Sales Card -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Sales</h3>
                <span class="text-3xl">💰</span>
            </div>
            <p class="text-gray-600 mb-4">Create sales orders with FIFO inventory allocation and payment tracking</p>
            <div class="space-y-2">
                <a asp-controller="Workflow" asp-action="CreateSale" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Create Sale
                </a>
                <a asp-controller="Workflow" asp-action="Sales" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Open Sales
                </a>
                <a asp-controller="Workflow" asp-action="Sales" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Manage Payments
                </a>
            </div>
        </div>
        
        <!-- Inventory Card -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Inventory</h3>
                <span class="text-3xl">📦</span>
            </div>
            <p class="text-gray-600 mb-4">Track raw and finished goods across multiple locations</p>
            <div class="space-y-2">
                <a asp-controller="Home" asp-action="Dashboard" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Inventory Overview
                </a>
                <a asp-controller="Admin" asp-action="Products" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Manage Products
                </a>
                <a asp-controller="Admin" asp-action="Locations" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Manage Locations
                </a>
            </div>
        </div>
        
        <!-- Transportation Card -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Transportation</h3>
                <span class="text-3xl">🚚</span>
            </div>
            <p class="text-gray-600 mb-4">Record and track transportation costs between locations</p>
            <div class="space-y-2">
                <a asp-controller="Workflow" asp-action="Index" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Transportation Records
                </a>
                <a asp-controller="Workflow" asp-action="Index" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Unpaid Costs
                </a>
            </div>
        </div>
        
        <!-- Reports Card -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Reports</h3>
                <span class="text-3xl">📊</span>
            </div>
            <p class="text-gray-600 mb-4">Comprehensive business intelligence and analytics</p>
            <div class="space-y-2">
                <a asp-controller="Home" asp-action="Dashboard" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → View Dashboard
                </a>
                <a asp-controller="Workflow" asp-action="Purchases" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Purchase Reports
                </a>
                <a asp-controller="Workflow" asp-action="Sales" class="block text-primary-600 hover:text-primary-700 text-sm">
                    → Sales Reports
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="bg-white rounded-lg shadow-md p-8 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Key Features</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
            <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900">Complete Traceability</h3>
                <p class="mt-2 text-gray-600">Track products from farmer to buyer with complete audit trail</p>
            </div>
        </div>
        
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
            <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900">Payment Management</h3>
                <p class="mt-2 text-gray-600">Track purchase and sales payments with flexible terms</p>
            </div>
        </div>
        
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
            </div>
            <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900">Real-time Reports</h3>
                <p class="mt-2 text-gray-600">Profitability, yield analysis, and inventory valuation</p>
            </div>
        </div>
        
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                </div>
            </div>
            <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900">FIFO Inventory</h3>
                <p class="mt-2 text-gray-600">Automatic first-in-first-out inventory allocation</p>
            </div>
        </div>
        
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
