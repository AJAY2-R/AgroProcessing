            </div>
            <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900">Multi-Stage Processing</h3>
                <p class="mt-2 text-gray-600">Manage complex processing workflows with worker tracking</p>
            </div>
        </div>
        
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                    </svg>
                </div>
            </div>
            <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900">RESTful API</h3>
                <p class="mt-2 text-gray-600">Complete API with Swagger documentation</p>
            </div>
        </div>
    </div>
</div>

<!-- Getting Started -->
<div class="bg-gradient-to-r from-blue-50 to-primary-50 rounded-lg p-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Getting Started</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
            <div class="bg-primary-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mb-3">
                1
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Set Up Master Data</h3>
            <p class="text-gray-600 mb-3">Add products, farmers, buyers, workers, and locations to the system</p>
            <a asp-controller="Admin" asp-action="Farmers" class="text-primary-600 hover:text-primary-700 font-medium text-sm">
                Start with Farmers →
            </a>
        </div>
        <div>
            <div class="bg-primary-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mb-3">
                2
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Record Purchases</h3>
            <p class="text-gray-600 mb-3">Create purchase batches from farmers and track payments</p>
            <a asp-controller="Workflow" asp-action="CreatePurchase" class="text-primary-600 hover:text-primary-700 font-medium text-sm">
                Create Purchase →
            </a>
        </div>
        <div>
