@model IEnumerable<AgroProcessing.Domain.Entries.RawInventory>
@{
    ViewData["Title"] = "All Raw Inventory";
}

<!-- Page Header with Back Button -->
<div class="mb-6">
    <div class="flex items-center space-x-4 mb-4">
        <a asp-action="Index" class="text-gray-600 hover:text-gray-900">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">All Raw Inventory</h1>
            <p class="text-gray-600">Complete overview of all raw material inventory</p>
        </div>
    </div>
</div>

<!-- Summary Stats -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
        <div class="flex items-center">
            <div class="bg-blue-100 rounded-lg p-3 mr-3">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
            <div>
                <p class="text-sm text-gray-500">Total Quantity</p>
                <p class="text-2xl font-bold text-gray-900">@Model.Sum(i => i.Quantity).ToString("N2") kg</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
        <div class="flex items-center">
            <div class="bg-green-100 rounded-lg p-3 mr-3">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
                </svg>
            </div>
            <div>
                <p class="text-sm text-gray-500">Total Batches</p>
                <p class="text-2xl font-bold text-gray-900">@Model.Select(i => i.PurchaseBatchId).Distinct().Count()</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
        <div class="flex items-center">
            <div class="bg-purple-100 rounded-lg p-3 mr-3">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                </svg>
            </div>
            <div>
                <p class="text-sm text-gray-500">Locations</p>
                <p class="text-2xl font-bold text-gray-900">@Model.Select(i => i.LocationId).Distinct().Count()</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
        <div class="flex items-center">
            <div class="bg-orange-100 rounded-lg p-3 mr-3">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
            </div>
            <div>
                <p class="text-sm text-gray-500">Products</p>
                <p class="text-2xl font-bold text-gray-900">@Model.Select(i => i.ProductId).Distinct().Count()</p>
            </div>
        </div>
    </div>
</div>

<!-- Filters (Optional Enhancement) -->
<div class="mb-4 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <span class="text-sm font-medium text-gray-700">Quick Filters:</span>
            <button onclick="filterByQuantity('all')" class="px-3 py-1.5 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors">
                All
            </button>
            <button onclick="filterByQuantity('high')" class="px-3 py-1.5 text-sm bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors">
                High Stock (>100kg)
            </button>
            <button onclick="filterByQuantity('medium')" class="px-3 py-1.5 text-sm bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors">
                Medium (50-100kg)
            </button>
            <button onclick="filterByQuantity('low')" class="px-3 py-1.5 text-sm bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors">
                Low Stock (<50kg)
            </button>
        </div>
        <span class="text-sm text-gray-600">Showing <span id="count">@Model.Count()</span> items</span>
    </div>
</div>

<!-- Inventory Table -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" id="inventoryTable">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Batch ID
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Product
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Location
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Quantity (kg)
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Status
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model.OrderByDescending(i => i.Quantity))
                    {
                        var stockLevel = item.Quantity > 100 ? "high" : item.Quantity > 50 ? "medium" : "low";
                        
                        <tr class="hover:bg-gray-50 transition-colors inventory-row" data-stock="@stockLevel" data-quantity="@item.Quantity">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">
                                    @item.PurchaseBatchId.ToString().Substring(0, 8)...
                                </div>
                                <div class="text-xs text-gray-500">
                                    Inv: @item.RawInventoryId.ToString().Substring(0, 8)
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="bg-green-100 rounded p-1.5 mr-2">
                                        <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                        </svg>
                                    </div>
                                    <span class="text-sm text-gray-900">@item.ProductId.ToString().Substring(0, 8)</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <svg class="w-4 h-4 text-purple-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    </svg>
                                    <span class="text-sm text-gray-700">@item.LocationId.ToString().Substring(0, 8)</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <span class="text-sm font-bold text-gray-900">@item.Quantity.ToString("N2")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (item.Quantity > 100)
                                {
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        High Stock
                                    </span>
                                }
                                else if (item.Quantity > 50)
                                {
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">
                                        Low Stock
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                <a asp-controller="Workflow" asp-action="PurchaseDetails" asp-route-id="@item.PurchaseBatchId" 
                                   class="text-blue-600 hover:text-blue-900">
                                    View
                                </a>
                                <a asp-action="RawInventoryByLocation" asp-route-locationId="@item.LocationId" 
                                   class="text-purple-600 hover:text-purple-900">
                                    Location
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No inventory</h3>
            <p class="mt-1 text-sm text-gray-500">No raw materials are currently in inventory.</p>
            <div class="mt-6">
                <a asp-controller="Workflow" asp-action="CreatePurchase" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    Create Purchase
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterByQuantity(level) {
            const rows = document.querySelectorAll('.inventory-row');
            let visibleCount = 0;
            
            rows.forEach(row => {
                const stockLevel = row.getAttribute('data-stock');
                
                if (level === 'all' || stockLevel === level) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            document.getElementById('count').textContent = visibleCount;
            
            // Update button styles
            document.querySelectorAll('button[onclick^="filterByQuantity"]').forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
            });
            event.target.classList.remove('bg-gray-200', 'text-gray-700');
            event.target.classList.add('bg-blue-600', 'text-white');
        }
    </script>
}
