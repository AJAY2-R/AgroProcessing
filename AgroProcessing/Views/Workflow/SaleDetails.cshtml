@model AgroProcessing.Domain.Entries.Sale
@{
    ViewData["Title"] = "Sale Details";
}

<!-- Page Header -->
<div class="mb-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a asp-action="Sales" class="text-gray-600 hover:text-gray-900">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Sale Details</h1>
                <p class="mt-1 text-gray-600">Sale ID: @Model.SaleId.ToString().Substring(0, 13)</p>
            </div>
        </div>
        @{
            var (sColor, sBg) = Model.Status == "Open" ? ("text-yellow-800", "bg-yellow-100") : ("text-green-800", "bg-green-100");
        }
        <span class="px-4 py-2 inline-flex text-sm font-semibold rounded-full @sBg @sColor">@Model.Status</span>
    </div>
</div>

<!-- Sale Information -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Sale Information</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-sm text-gray-600">Sale Date</p>
                    <p class="text-lg font-medium">@Model.SaleDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Buyer ID</p>
                    <p class="text-lg font-medium">@Model.BuyerId.ToString().Substring(0, 13)</p>
                </div>
                <div class="col-span-2">
                    <p class="text-sm text-gray-600">Total Amount</p>
                    <p class="text-3xl font-bold text-orange-600">₹@Model.TotalAmount.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Actions</h2>
            @if (Model.Status == "Open")
            {
                <button onclick="closeSale('@Model.SaleId')" class="w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 mb-2">
                    Close Sale
                </button>
            }
            <button class="w-full px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                View History
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function closeSale(saleId) {
            if (!confirm('Are you sure you want to close this sale?')) return;
            
            try {
                const response = await fetch(`/Workflow/CloseSale?id=${saleId}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to close sale');
                }
            } catch (error) {
                alert('An error occurred');
            }
        }
    </script>
}
