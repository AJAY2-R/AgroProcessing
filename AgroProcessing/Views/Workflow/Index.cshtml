@{
    ViewData["Title"] = "Workflow Dashboard";
}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-900">Workflow Dashboard</h1>
    <p class="mt-2 text-gray-600 text-lg">Manage your operational workflows</p>
</div>

<!-- Workflow Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Purchase Workflow -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden">
        <div class="bg-gradient-to-r from-green-500 to-green-600 px-6 py-8 text-white text-center">
            <svg class="w-16 h-16 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <h2 class="text-2xl font-bold">Purchase</h2>
            <p class="mt-2 text-green-100">Buy raw materials from farmers</p>
        </div>
        <div class="p-6 space-y-3">
            <a asp-action="Purchases" class="block w-full px-4 py-2 bg-green-50 text-green-700 text-center rounded-lg hover:bg-green-100 font-medium">
                View Purchases
            </a>
            <a asp-action="CreatePurchase" class="block w-full px-4 py-2 bg-green-600 text-white text-center rounded-lg hover:bg-green-700 font-medium">
                + New Purchase
            </a>
        </div>
    </div>

    <!-- Processing Workflow -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden">
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-8 text-white text-center">
            <svg class="w-16 h-16 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <h2 class="text-2xl font-bold">Processing</h2>
            <p class="mt-2 text-purple-100">Process raw materials</p>
        </div>
        <div class="p-6 space-y-3">
            <a asp-action="Processing" class="block w-full px-4 py-2 bg-purple-50 text-purple-700 text-center rounded-lg hover:bg-purple-100 font-medium">
                View Processing Runs
            </a>
            <a asp-action="CreateProcessingRun" class="block w-full px-4 py-2 bg-purple-600 text-white text-center rounded-lg hover:bg-purple-700 font-medium">
                + New Processing Run
            </a>
        </div>
    </div>

    <!-- Sales Workflow -->
    <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden">
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-8 text-white text-center">
            <svg class="w-16 h-16 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h2 class="text-2xl font-bold">Sales</h2>
            <p class="mt-2 text-orange-100">Sell finished products</p>
        </div>
        <div class="p-6 space-y-3">
            <a asp-action="Sales" class="block w-full px-4 py-2 bg-orange-50 text-orange-700 text-center rounded-lg hover:bg-orange-100 font-medium">
                View Sales
            </a>
            <a asp-action="CreateSale" class="block w-full px-4 py-2 bg-orange-600 text-white text-center rounded-lg hover:bg-orange-700 font-medium">
                + New Sale
            </a>
        </div>
    </div>
</div>

<!-- Workflow Process Flow -->
<div class="bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Workflow Process</h2>
    <div class="flex items-center justify-between">
        <div class="text-center flex-1">
            <div class="bg-green-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3">
                <span class="text-3xl font-bold text-green-600">1</span>
            </div>
            <h3 class="font-semibold text-gray-900">Purchase</h3>
            <p class="text-sm text-gray-600 mt-1">Buy raw materials</p>
        </div>
        <svg class="w-12 h-12 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
        <div class="text-center flex-1">
            <div class="bg-purple-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3">
                <span class="text-3xl font-bold text-purple-600">2</span>
            </div>
            <h3 class="font-semibold text-gray-900">Processing</h3>
            <p class="text-sm text-gray-600 mt-1">Process materials</p>
        </div>
        <svg class="w-12 h-12 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
        <div class="text-center flex-1">
            <div class="bg-orange-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3">
                <span class="text-3xl font-bold text-orange-600">3</span>
            </div>
            <h3 class="font-semibold text-gray-900">Sales</h3>
            <p class="text-sm text-gray-600 mt-1">Sell products</p>
        </div>
    </div>
</div>
