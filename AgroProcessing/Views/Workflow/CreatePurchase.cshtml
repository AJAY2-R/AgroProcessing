@model AgroProcessing.DTOs.Purchase.CreatePurchaseBatchDto
@{
    ViewData["Title"] = "Create Purchase";
    var farmers = ViewBag.Farmers as IEnumerable<AgroProcessing.Domain.Entries.Farmer>;
    var products = ViewBag.Products as IEnumerable<AgroProcessing.Domain.Entries.Product>;
}

<!-- Page Header with Back Button -->
<div class="mb-6">
    <div class="flex items-center space-x-4 mb-4">
        <a asp-action="Purchases" class="text-gray-600 hover:text-gray-900">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Create Purchase</h1>
            <p class="mt-1 text-gray-600">Record a new raw material purchase from farmer</p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white rounded-lg shadow-md p-8 max-w-4xl">
    <form asp-action="CreatePurchase" method="post" id="purchaseForm">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Farmer Selection -->
            <div class="md:col-span-2">
                <label asp-for="FarmerId" class="block text-sm font-medium text-gray-700 mb-2">
                    Select Farmer <span class="text-red-500">*</span>
                </label>
                <select asp-for="FarmerId" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                        required>
                    <option value="">-- Select a Farmer --</option>
                    @if (farmers != null)
                    {
                        @foreach (var farmer in farmers)
                        {
                            <option value="@farmer.FarmerId">@farmer.Name @(!string.IsNullOrEmpty(farmer.Phone) ? $"({farmer.Phone})" : "")</option>
                        }
                    }
                </select>
                <span asp-validation-for="FarmerId" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Product Selection -->
            <div class="md:col-span-2">
                <label asp-for="ProductId" class="block text-sm font-medium text-gray-700 mb-2">
                    Select Product <span class="text-red-500">*</span>
                </label>
                <select asp-for="ProductId" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                        required>
                    <option value="">-- Select a Product --</option>
                    @if (products != null)
                    {
                        @foreach (var product in products)
                        {
                            <option value="@product.ProductId">@product.Name (Yield: @product.ExpectedYieldPercent%)</option>
                        }
                    }
                </select>
                <span asp-validation-for="ProductId" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Purchase Date -->
            <div>
                <label asp-for="PurchaseDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Purchase Date <span class="text-red-500">*</span>
                </label>
                <input asp-for="PurchaseDate" 
                       type="datetime-local" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                       required />
                <span asp-validation-for="PurchaseDate" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Raw Weight -->
            <div>
                <label asp-for="RawWeight" class="block text-sm font-medium text-gray-700 mb-2">
                    Raw Weight (kg) <span class="text-red-500">*</span>
                </label>
                <input asp-for="RawWeight" 
                       type="number" 
                       step="0.01" 
                       min="0"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                       placeholder="0.00"
                       required
                       oninput="calculateTotal()" />
                <span asp-validation-for="RawWeight" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Rate Per Kg -->
            <div>
                <label asp-for="RatePerKg" class="block text-sm font-medium text-gray-700 mb-2">
                    Rate per Kg (₹) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 text-sm">₹</span>
                    </div>
                    <input asp-for="RatePerKg" 
                           type="number" 
                           step="0.01" 
                           min="0"
                           class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                           placeholder="0.00"
                           required
                           oninput="calculateTotal()" />
                </div>
                <span asp-validation-for="RatePerKg" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Total Amount (Calculated) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Total Amount (₹)
                </label>
                <div class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-lg font-bold text-green-600">
                    ₹<span id="totalAmount">0.00</span>
                </div>
            </div>

            <!-- Payment Settlement Type -->
            <div class="md:col-span-2">
                <label asp-for="PaymentSettlementType" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Settlement Type <span class="text-red-500">*</span>
                </label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="relative flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-green-500 transition-colors">
                        <input type="radio" asp-for="PaymentSettlementType" value="BeforeProcessing" class="mr-3" required />
                        <div>
                            <div class="font-medium text-gray-900">Before Processing</div>
                            <div class="text-sm text-gray-500">Pay before processing starts</div>
                        </div>
                    </label>
                    <label class="relative flex items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-green-500 transition-colors">
                        <input type="radio" asp-for="PaymentSettlementType" value="AfterYield" class="mr-3" required />
                        <div>
                            <div class="font-medium text-gray-900">After Yield</div>
                            <div class="text-sm text-gray-500">Pay after yield calculation</div>
                        </div>
                    </label>
                </div>
                <span asp-validation-for="PaymentSettlementType" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Initial Payment -->
            <div>
                <label asp-for="InitialPayment" class="block text-sm font-medium text-gray-700 mb-2">
                    Initial Payment (?)
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 text-sm">₹</span>
                    </div>
                    <input asp-for="InitialPayment" 
                           type="number" 
                           step="0.01" 
                           min="0"
                           class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                           placeholder="0.00" />
                </div>
                <p class="text-sm text-gray-500 mt-1">Optional initial payment amount</p>
                <span asp-validation-for="InitialPayment" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- Payment Mode -->
            <div>
                <label asp-for="PaymentMode" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Mode
                </label>
                <select asp-for="PaymentMode" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all">
                    <option value="">-- Select Payment Mode --</option>
                    <option value="Cash">Cash</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="Cheque">Cheque</option>
                    <option value="UPI">UPI</option>
                </select>
                <span asp-validation-for="PaymentMode" class="text-red-500 text-sm mt-1 block"></span>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-between border-t border-gray-200 pt-6 mt-8">
            <a asp-action="Purchases" class="px-6 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors shadow-md flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Create Purchase
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calculateTotal() {
            const weight = parseFloat(document.querySelector('input[name="RawWeight"]').value) || 0;
            const rate = parseFloat(document.querySelector('input[name="RatePerKg"]').value) || 0;
            const total = weight * rate;
            document.getElementById('totalAmount').textContent = total.toFixed(2);
        }

        // Set default date to now
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.querySelector('input[name="PurchaseDate"]');
            if (!dateInput.value) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                dateInput.value = now.toISOString().slice(0, 16);
            }
        });
    </script>
}
