@model AgroProcessing.Domain.Entries.PurchaseBatch
@{
    ViewData["Title"] = "Purchase Details";
    var outstanding = ViewBag.Outstanding as decimal?;
    var inventory = ViewBag.Inventory as AgroProcessing.Domain.Entries.RawInventory;
}

<!-- Page Header with Back Button -->
<div class="mb-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a asp-action="Purchases" class="text-gray-600 hover:text-gray-900">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Purchase Details</h1>
                <p class="mt-1 text-gray-600">Purchase ID: @Model.PurchaseBatchId.ToString().Substring(0, 13)</p>
            </div>
        </div>
        <div>
            @{
                var (statusColor, statusBg, statusText) = Model.Status switch
                {
                    "Stored" => ("text-blue-800", "bg-blue-100", "Stored"),
                    "Processing" => ("text-yellow-800", "bg-yellow-100", "Processing"),
                    "Completed" => ("text-green-800", "bg-green-100", "Completed"),
                    _ => ("text-gray-800", "bg-gray-100", Model.Status)
                };
            }
            <span class="px-4 py-2 inline-flex text-sm leading-5 font-semibold rounded-full @statusBg @statusColor">
                @statusText
            </span>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-lg">
        <div class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-green-800 font-medium">@TempData["SuccessMessage"]</p>
        </div>
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Details -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Purchase Information -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Purchase Information</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-sm text-gray-600">Purchase Date</p>
                    <p class="text-lg font-medium text-gray-900">@Model.PurchaseDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Farmer ID</p>
                    <p class="text-lg font-medium text-gray-900">@Model.FarmerId.ToString().Substring(0, 13)</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Product ID</p>
                    <p class="text-lg font-medium text-gray-900">@Model.ProductId.ToString().Substring(0, 13)</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Payment Settlement</p>
                    <p class="text-lg font-medium text-gray-900">@Model.PaymentSettlementType</p>
                </div>
            </div>
        </div>

        <!-- Weight & Amount Details -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Weight & Amount Details</h2>
            <div class="space-y-4">
                <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg">
                    <div>
                        <p class="text-sm text-gray-600">Raw Weight</p>
                        <p class="text-2xl font-bold text-gray-900">@Model.RawWeight.ToString("N2") kg</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-600">Rate per Kg</p>
                        <p class="text-xl font-semibold text-gray-900">?@Model.RatePerKg.ToString("N2")</p>
                    </div>
                </div>
                <div class="flex justify-between items-center p-4 bg-green-50 rounded-lg border-2 border-green-200">
                    <p class="text-lg font-medium text-gray-900">Total Amount</p>
                    <p class="text-3xl font-bold text-green-600">?@Model.TotalAmount.ToString("N2")</p>
                </div>
            </div>
        </div>

        <!-- Inventory Status -->
        @if (inventory != null)
        {
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Inventory Status</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-600">Available Weight</p>
                        <p class="text-lg font-medium text-gray-900">@inventory.Quantity.ToString("N2") kg</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Location ID</p>
                        <p class="text-lg font-medium text-gray-900">@inventory.LocationId.ToString().Substring(0, 13)</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Payment Summary -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Payment Summary</h2>
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Total Amount</span>
                    <span class="font-semibold text-gray-900">?@Model.TotalAmount.ToString("N2")</span>
                </div>
                @if (outstanding.HasValue)
                {
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600">Paid</span>
                        <span class="font-semibold text-green-600">?@((Model.TotalAmount - outstanding.Value).ToString("N2"))</span>
                    </div>
                    <div class="pt-3 border-t border-gray-200">
                        <div class="flex justify-between items-center">
                            <span class="text-lg font-medium text-gray-900">Outstanding</span>
                            <span class="text-lg font-bold text-red-600">?@outstanding.Value.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
            @if (outstanding.HasValue && outstanding.Value > 0)
            {
                <button class="mt-4 w-full px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors">
                    Record Payment
                </button>
            }
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Quick Actions</h2>
            <div class="space-y-2">
                @if (Model.Status == "Stored")
                {
                    <button class="w-full px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
                        Start Processing
                    </button>
                }
                <button class="w-full px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                    View History
                </button>
                <button class="w-full px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                    Generate Report
                </button>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-lg shadow-md p-6 border border-green-200">
            <div class="flex items-start space-x-3">
                <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <h3 class="text-sm font-semibold text-green-900 mb-1">Purchase Workflow</h3>
                    <p class="text-sm text-green-800">
                        This purchase is currently in <strong>@Model.Status</strong> status. 
                        @if (Model.Status == "Stored")
                        {
                            <span>You can start processing when ready.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
