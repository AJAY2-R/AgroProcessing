@model AgroProcessing.DTOs.Sales.CreateSaleDto
@{
    ViewData["Title"] = "Create Sale";
    var buyers = ViewBag.Buyers as IEnumerable<AgroProcessing.Domain.Entries.Buyer>;
    var products = ViewBag.Products as IEnumerable<AgroProcessing.Domain.Entries.Product>;
}

<!-- Page Header -->
<div class="mb-6">
    <div class="flex items-center space-x-4">
        <a asp-action="Sales" class="text-gray-600 hover:text-gray-900">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Create Sale</h1>
            <p class="mt-1 text-gray-600">Record a new sale to buyer</p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white rounded-lg shadow-md p-8 max-w-4xl">
    <form asp-action="CreateSale" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg"></div>

        <!-- Buyer Selection -->
        <div class="mb-6">
            <label asp-for="BuyerId" class="block text-sm font-medium text-gray-700 mb-2">
                Select Buyer <span class="text-red-500">*</span>
            </label>
            <select asp-for="BuyerId" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500" required>
                <option value="">-- Select Buyer --</option>
                @if (buyers != null)
                {
                    @foreach (var buyer in buyers)
                    {
                        <option value="@buyer.BuyerId">@buyer.Name (Credit: ?@buyer.CreditLimit.ToString("N2"))</option>
                    }
                }
            </select>
        </div>

        <!-- Sale Date -->
        <div class="mb-6">
            <label asp-for="SaleDate" class="block text-sm font-medium text-gray-700 mb-2">
                Sale Date <span class="text-red-500">*</span>
            </label>
            <input asp-for="SaleDate" type="datetime-local" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500" required />
        </div>

        <!-- Sale Items -->
        <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
                <label class="block text-sm font-medium text-gray-700">Sale Items <span class="text-red-500">*</span></label>
                <button type="button" onclick="addSaleItem()" class="px-3 py-1 bg-orange-600 text-white text-sm rounded hover:bg-orange-700">
                    + Add Item
                </button>
            </div>
            <div id="itemsContainer" class="space-y-3"></div>
        </div>

        <!-- Total Display -->
        <div class="mb-8 p-6 bg-orange-50 border-2 border-orange-300 rounded-lg">
            <div class="flex justify-between items-center">
                <span class="text-lg font-medium text-gray-900">Total Amount</span>
                <span class="text-3xl font-bold text-orange-600">?<span id="totalAmount">0.00</span></span>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-between border-t pt-6">
            <a asp-action="Sales" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">Cancel</a>
            <button type="submit" class="px-6 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700">Create Sale</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let itemCounter = 0;
        const productsData = @Html.Raw(products != null ? Json.Serialize(products.Select(p => new { id = p.ProductId, name = p.Name })) : "[]");

        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.querySelector('input[name="SaleDate"]');
            if (!dateInput.value) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                dateInput.value = now.toISOString().slice(0, 16);
            }
        });

        function addSaleItem() {
            const container = document.getElementById('itemsContainer');
            const row = document.createElement('div');
            row.className = 'grid grid-cols-12 gap-3 items-center';
            row.id = `item-row-${itemCounter}`;
            
            row.innerHTML = `
                <div class="col-span-5">
                    <select name="Items[${itemCounter}].ProductId" class="w-full px-3 py-2 border rounded-lg text-sm" required>
                        <option value="">-- Select Product --</option>
                        ${productsData.map(p => `<option value="${p.id}">${p.name}</option>`).join('')}
                    </select>
                </div>
                <div class="col-span-3">
                    <input type="number" name="Items[${itemCounter}].Quantity" step="0.01" min="0.01" 
                           class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="Qty (kg)" required onchange="calculateTotal()" />
                </div>
                <div class="col-span-3">
                    <input type="number" name="Items[${itemCounter}].Rate" step="0.01" min="0.01" 
                           class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="Rate (?)" required onchange="calculateTotal()" />
                </div>
                <div class="col-span-1">
                    <button type="button" onclick="removeSaleItem(${itemCounter})" class="text-red-600 hover:text-red-800">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            `;
            container.appendChild(row);
            itemCounter++;
        }

        function removeSaleItem(id) {
            document.getElementById(`item-row-${id}`)?.remove();
            calculateTotal();
        }

        function calculateTotal() {
            let total = 0;
            document.querySelectorAll('#itemsContainer > div').forEach(row => {
                const qty = parseFloat(row.querySelector('input[name$="Quantity"]')?.value) || 0;
                const rate = parseFloat(row.querySelector('input[name$="Rate"]')?.value) || 0;
                total += qty * rate;
            });
            document.getElementById('totalAmount').textContent = total.toFixed(2);
        }
    </script>
}
