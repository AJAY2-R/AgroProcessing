@model AgroProcessing.Domain.Entries.ProcessingRun
@{
    ViewData["Title"] = "Processing Details";
    var totalCost = ViewBag.TotalCost as decimal?;
}

<!-- Page Header -->
<div class="mb-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a asp-action="Processing" class="text-gray-600 hover:text-gray-900">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Processing Run Details</h1>
                <p class="mt-1 text-gray-600">ID: @Model.ProcessingRunId.ToString().Substring(0, 13)</p>
            </div>
        </div>
        @{
            var (statusColor, statusBg) = Model.Status switch
            {
                "Started" => ("text-blue-800", "bg-blue-100"),
                "Completed" => ("text-green-800", "bg-green-100"),
                _ => ("text-gray-800", "bg-gray-100")
            };
        }
        <span class="px-4 py-2 inline-flex text-sm leading-5 font-semibold rounded-full @statusBg @statusColor">
            @Model.Status
        </span>
    </div>
</div>

<!-- Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-lg">
        <p class="text-green-800 font-medium">@TempData["SuccessMessage"]</p>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
        <p class="text-red-800 font-medium">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Run Information -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Run Information</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-sm text-gray-600">Product ID</p>
                    <p class="text-lg font-medium text-gray-900">@Model.ProductId.ToString().Substring(0, 13)</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Start Date</p>
                    <p class="text-lg font-medium text-gray-900">@Model.StartDate.ToString("MMM dd, yyyy")</p>
                </div>
                @if (Model.EndDate.HasValue)
                {
                    <div>
                        <p class="text-sm text-gray-600">End Date</p>
                        <p class="text-lg font-medium text-gray-900">@Model.EndDate.Value.ToString("MMM dd, yyyy")</p>
                    </div>
                }
                @if (totalCost.HasValue)
                {
                    <div>
                        <p class="text-sm text-gray-600">Total Cost</p>
                        <p class="text-lg font-bold text-purple-600">₹@totalCost.Value.ToString("N2")</p>
                    </div>
                }
            </div>
        </div>

        <!-- Complete Processing Form -->
        @if (Model.Status == "Started")
        {
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Complete Processing Run</h2>
                <form asp-action="CompleteProcessingRun" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProcessingRunId" value="@Model.ProcessingRunId" />
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">End Date <span class="text-red-500">*</span></label>
                            <input type="datetime-local" name="EndDate" class="w-full px-4 py-2 border rounded-lg" required />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Total Output Weight (kg) <span class="text-red-500">*</span></label>
                            <input type="number" name="TotalOutputWeight" step="0.01" min="0.01" class="w-full px-4 py-2 border rounded-lg" required />
                        </div>
                        <button type="submit" class="w-full px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700">
                            Complete Processing Run
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Quick Actions</h2>
            <div class="space-y-2">
                <button onclick="showComingSoon('View Stages')" class="w-full px-4 py-2 bg-purple-100 text-purple-700 font-medium rounded-lg hover:bg-purple-200 transition-colors">
                    View Stages
                </button>
                <button onclick="showComingSoon('View Workers')" class="w-full px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                    View Workers
                </button>
                <button onclick="showComingSoon('View Costs')" class="w-full px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                    View Costs
                </button>
                <a asp-action="Processing" class="block w-full px-4 py-2 bg-blue-100 text-blue-700 font-medium rounded-lg hover:bg-blue-200 transition-colors text-center">
                    Back to Processing List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showComingSoon(feature) {
            alert(feature + ' feature is coming soon!');
        }
    </script>
}
