@model AgroProcessing.Domain.Entries.Location
@{
    ViewData["Title"] = "Create Location";
}

<!-- Page Header with Back Button -->
<div class="mb-6">
    <div class="flex items-center space-x-4 mb-4">
        <a asp-action="Locations" class="text-gray-600 hover:text-gray-900">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Create Location</h1>
            <p class="mt-1 text-gray-600">Add a new storage or processing location</p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white rounded-lg shadow-md p-8 max-w-2xl">
    <form asp-action="CreateLocation" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg hidden"></div>

        <!-- Location Name -->
        <div class="mb-6">
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">
                Location Name <span class="text-red-500">*</span>
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <input asp-for="Name" 
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all" 
                       placeholder="e.g., Warehouse A, Processing Unit 1" />
            </div>
            <span asp-validation-for="Name" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Location Type -->
        <div class="mb-8">
            <label asp-for="LocationType" class="block text-sm font-medium text-gray-700 mb-2">
                Location Type <span class="text-red-500">*</span>
            </label>
            <select asp-for="LocationType" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all">
                <option value="">Select a type...</option>
                <option value="Raw">Raw - Raw Material Storage</option>
                <option value="Processing">Processing - Processing Area</option>
                <option value="Drying">Drying - Drying Facility</option>
                <option value="Finished">Finished - Finished Goods Storage</option>
            </select>
            <span asp-validation-for="LocationType" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Location Type Info -->
        <div class="mb-8 bg-teal-50 border-l-4 border-teal-500 p-4 rounded-lg">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-teal-800">Location Type Guide</h3>
                    <div class="mt-2 text-sm text-teal-700">
                        <ul class="list-disc list-inside space-y-1">
                            <li><strong>Raw:</strong> For storing raw materials from purchases</li>
                            <li><strong>Processing:</strong> For active processing operations</li>
                            <li><strong>Drying:</strong> For drying processed materials</li>
                            <li><strong>Finished:</strong> For storing finished products ready for sale</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-between border-t border-gray-200 pt-6">
            <a asp-action="Locations" class="px-6 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2 bg-teal-600 text-white font-medium rounded-lg hover:bg-teal-700 transition-colors shadow-md flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Create Location
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
