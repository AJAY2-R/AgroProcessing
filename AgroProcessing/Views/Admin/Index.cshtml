@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Page Header with Gradient Background -->
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-lg shadow-lg p-8 mb-8 text-white">
    <h1 class="text-4xl font-bold mb-2">Admin Dashboard</h1>
    <p class="text-indigo-100 text-lg">Manage master data and system configuration</p>
</div>

<!-- Quick Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Products Card -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600 uppercase">Products</p>
                <p class="text-3xl font-bold text-gray-900 mt-2" id="productsCount">-</p>
            </div>
            <div class="bg-blue-100 rounded-full p-3">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
        </div>
        <a asp-action="Products" class="mt-4 inline-block text-blue-600 hover:text-blue-800 text-sm font-medium">
            View All
        </a>
    </div>

    <!-- Farmers Card -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600 uppercase">Farmers</p>
                <p class="text-3xl font-bold text-gray-900 mt-2" id="farmersCount">-</p>
            </div>
            <div class="bg-green-100 rounded-full p-3">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
            </div>
        </div>
        <a asp-action="Farmers" class="mt-4 inline-block text-green-600 hover:text-green-800 text-sm font-medium">
            View All
        </a>
    </div>

    <!-- Workers Card -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-purple-500 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600 uppercase">Workers</p>
                <p class="text-3xl font-bold text-gray-900 mt-2" id="workersCount">-</p>
            </div>
            <div class="bg-purple-100 rounded-full p-3">
                <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
            </div>
        </div>
        <a asp-action="Workers" class="mt-4 inline-block text-purple-600 hover:text-purple-800 text-sm font-medium">
            View All
        </a>
    </div>

    <!-- Buyers Card -->
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-orange-500 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600 uppercase">Buyers</p>
                <p class="text-3xl font-bold text-gray-900 mt-2" id="buyersCount">-</p>
            </div>
            <div class="bg-orange-100 rounded-full p-3">
                <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
            </div>
        </div>
        <a asp-action="Buyers" class="mt-4 inline-block text-orange-600 hover:text-orange-800 text-sm font-medium">
            View All
        </a>
    </div>
</div>

<!-- Management Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <!-- Products Management -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h3 class="text-xl font-bold text-white flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
                Products
            </h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 mb-4">Manage product catalog, yield percentages, and drying parameters</p>
            <div class="space-y-2">
                <a asp-action="Products" class="block w-full text-center px-4 py-2 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors font-medium">
                    View Products
                </a>
                <a asp-action="CreateProduct" class="block w-full text-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                    + Add New Product
                </a>
            </div>
        </div>
    </div>

    <!-- Farmers Management -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
        <div class="bg-gradient-to-r from-green-500 to-green-600 px-6 py-4">
            <h3 class="text-xl font-bold text-white flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                Farmers
            </h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 mb-4">Maintain farmer database with contact information</p>
            <div class="space-y-2">
                <a asp-action="Farmers" class="block w-full text-center px-4 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors font-medium">
                    View Farmers
                </a>
                <a asp-action="CreateFarmer" class="block w-full text-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium">
                    + Add New Farmer
                </a>
            </div>
        </div>
    </div>

    <!-- Workers Management -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4">
            <h3 class="text-xl font-bold text-white flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                Workers
            </h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 mb-4">Manage workers, skills, and default rates</p>
            <div class="space-y-2">
                <a asp-action="Workers" class="block w-full text-center px-4 py-2 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition-colors font-medium">
                    View Workers
                </a>
                <a asp-action="CreateWorker" class="block w-full text-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium">
                    + Add New Worker
                </a>
            </div>
        </div>
    </div>

    <!-- Buyers Management -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-4">
            <h3 class="text-xl font-bold text-white flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                Buyers
            </h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 mb-4">Manage buyer information and credit limits</p>
            <div class="space-y-2">
                <a asp-action="Buyers" class="block w-full text-center px-4 py-2 bg-orange-50 text-orange-700 rounded-lg hover:bg-orange-100 transition-colors font-medium">
                    View Buyers
                </a>
                <a asp-action="CreateBuyer" class="block w-full text-center px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors font-medium">
                    + Add New Buyer
                </a>
            </div>
        </div>
    </div>

    <!-- Locations Management -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
        <div class="bg-gradient-to-r from-teal-500 to-teal-600 px-6 py-4">
            <h3 class="text-xl font-bold text-white flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Locations
            </h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 mb-4">Configure storage and processing locations</p>
            <div class="space-y-2">
                <a asp-action="Locations" class="block w-full text-center px-4 py-2 bg-teal-50 text-teal-700 rounded-lg hover:bg-teal-100 transition-colors font-medium">
                    View Locations
                </a>
                <a asp-action="CreateLocation" class="block w-full text-center px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors font-medium">
                    + Add New Location
                </a>
            </div>
        </div>
    </div>

    <!-- System Info Card -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
        <div class="bg-gradient-to-r from-gray-700 to-gray-800 px-6 py-4">
            <h3 class="text-xl font-bold text-white flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                System Info
            </h3>
        </div>
        <div class="p-6">
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-gray-600 text-sm">Version</span>
                    <span class="text-gray-900 font-medium">1.0.0</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600 text-sm">Database</span>
                    <span class="text-green-600 font-medium flex items-center">
                        <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                        Connected
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600 text-sm">Last Backup</span>
                    <span class="text-gray-900 font-medium text-sm">Today</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load counts via API
        async function loadCounts() {
            try {
                const [products, farmers, workers, buyers] = await Promise.all([
                    fetch('/api/products').then(r => r.json()),
                    fetch('/api/farmers').then(r => r.json()),
                    fetch('/api/workers').then(r => r.json()),
                    fetch('/api/buyers').then(r => r.json())
                ]);

                document.getElementById('productsCount').textContent = products.data?.length || 0;
                document.getElementById('farmersCount').textContent = farmers.data?.length || 0;
                document.getElementById('workersCount').textContent = workers.data?.length || 0;
                document.getElementById('buyersCount').textContent = buyers.data?.length || 0;
            } catch (error) {
                console.error('Error loading counts:', error);
            }
        }

        loadCounts();
    </script>
}
