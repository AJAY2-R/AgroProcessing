@model AgroProcessing.Domain.Entries.Product
@{
    ViewData["Title"] = "Edit Product";
}

<!-- Page Header with Back Button -->
<div class="mb-6">
    <div class="flex items-center space-x-4 mb-4">
        <a asp-action="Products" class="text-gray-600 hover:text-gray-900">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Edit Product</h1>
            <p class="mt-1 text-gray-600">Update product information</p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white rounded-lg shadow-md p-8 max-w-2xl">
    <form asp-action="EditProduct" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />
        
        <div asp-validation-summary="ModelOnly" class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg hidden"></div>

        <!-- Product Name -->
        <div class="mb-6">
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">
                Product Name <span class="text-red-500">*</span>
            </label>
            <input asp-for="Name" 
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" 
                   placeholder="e.g., Turmeric, Ginger, Arrowroot" />
            <span asp-validation-for="Name" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Expected Yield Percentage -->
        <div class="mb-6">
            <label asp-for="ExpectedYieldPercent" class="block text-sm font-medium text-gray-700 mb-2">
                Expected Yield Percentage <span class="text-red-500">*</span>
            </label>
            <div class="relative">
                <input asp-for="ExpectedYieldPercent" 
                       type="number" 
                       step="0.01" 
                       min="0" 
                       max="100"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all pr-12" />
                <span class="absolute right-3 top-2 text-gray-500 text-sm">%</span>
            </div>
            <span asp-validation-for="ExpectedYieldPercent" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Drying Days Range -->
        <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="DryingDaysMin" class="block text-sm font-medium text-gray-700 mb-2">
                    Minimum Drying Days <span class="text-red-500">*</span>
                </label>
                <input asp-for="DryingDaysMin" 
                       type="number" 
                       min="0"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
                <span asp-validation-for="DryingDaysMin" class="text-red-500 text-sm mt-1 block"></span>
            </div>
            <div>
                <label asp-for="DryingDaysMax" class="block text-sm font-medium text-gray-700 mb-2">
                    Maximum Drying Days <span class="text-red-500">*</span>
                </label>
                <input asp-for="DryingDaysMax" 
                       type="number" 
                       min="0"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
                <span asp-validation-for="DryingDaysMax" class="text-red-500 text-sm mt-1 block"></span>
            </div>
        </div>

        <!-- Status -->
        <div class="mb-8">
            <label class="flex items-center space-x-3 cursor-pointer">
                <input asp-for="IsActive" 
                       type="checkbox" 
                       class="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                <span class="text-sm font-medium text-gray-700">
                    Product is Active
                </span>
            </label>
            <p class="text-sm text-gray-500 mt-1 ml-8">Active products are available for transactions</p>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-between border-t border-gray-200 pt-6">
            <a asp-action="Products" class="px-6 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-md flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Update Product
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
