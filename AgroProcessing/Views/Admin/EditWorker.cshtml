@model AgroProcessing.Domain.Entries.Worker
@{
    ViewData["Title"] = "Edit Worker";
}

<!-- Page Header with Back Button -->
<div class="mb-6">
    <div class="flex items-center space-x-4 mb-4">
        <a asp-action="Workers" class="text-gray-600 hover:text-gray-900">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Edit Worker</h1>
            <p class="mt-1 text-gray-600">Update worker information</p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white rounded-lg shadow-md p-8 max-w-2xl">
    <form asp-action="EditWorker" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="WorkerId" />
        
        <div asp-validation-summary="ModelOnly" class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg hidden"></div>

        <!-- Worker Name -->
        <div class="mb-6">
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">
                Worker Name <span class="text-red-500">*</span>
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <input asp-for="Name" 
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="Name" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Skill Type -->
        <div class="mb-6">
            <label asp-for="SkillType" class="block text-sm font-medium text-gray-700 mb-2">
                Skill Type
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                </div>
                <input asp-for="SkillType" 
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="SkillType" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Default Rate -->
        <div class="mb-6">
            <label asp-for="DefaultRate" class="block text-sm font-medium text-gray-700 mb-2">
                Default Rate <span class="text-red-500">*</span>
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="text-gray-500 text-sm">₹</span>
                </div>
                <input asp-for="DefaultRate" 
                       type="number" 
                       step="0.01" 
                       min="0"
                       class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" />
            </div>
            <span asp-validation-for="DefaultRate" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <!-- Status -->
        <div class="mb-8">
            <label class="flex items-center space-x-3 cursor-pointer">
                <input asp-for="IsActive" 
                       type="checkbox" 
                       class="w-5 h-5 text-purple-600 border-gray-300 rounded focus:ring-purple-500" />
                <span class="text-sm font-medium text-gray-700">
                    Worker is Active
                </span>
            </label>
            <p class="text-sm text-gray-500 mt-1 ml-8">Active workers are available for assignments</p>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-between border-t border-gray-200 pt-6">
            <a asp-action="Workers" class="px-6 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2 bg-purple-600 text-white font-medium rounded-lg hover:bg-purple-700 transition-colors shadow-md flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Update Worker
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
